#!/usr/bin/env bash
set -eu

ZAW_LIBEXEC=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=libexec/zaw-common
. "$ZAW_LIBEXEC/zaw-common"

RENDER_NOTES="$ZAW_LIBEXEC/zaw-render-notes"
open_after=${ZAW_NOTES_OPEN:-0}

for arg in "$@"; do
  case "$arg" in
    --open)
      open_after=1
      ;;
  esac
done

zaw_resolve_root "$@"
root=$ZAW_ROOT
zaw_load_config "$root"

root_tex=$(find_root_tex "$root" "$ZAW_TEX_ARG")
build_dir=$(zaw_build_dir "$root")
root_tex_base=$(basename "$root_tex")
pdf_path="$build_dir/${root_tex_base%.tex}.pdf"
notes_path="$build_dir/skim-notes.md"
plist_notes_path="$build_dir/skim-notes.plist"
link_text="[skim-notes.md]($notes_path)"

backend=$(zaw_pdf_backend)

if [ ! -x "$RENDER_NOTES" ]; then
  msg "notes renderer not found: $RENDER_NOTES"
  exit 1
fi

zaw_require_pdf "$pdf_path"

mkdir -p "$build_dir"

"$backend" extract-notes "$pdf_path" "$plist_notes_path"
"$RENDER_NOTES" "$plist_notes_path" "$pdf_path" "$root_tex" "$root" "$ZED_LATEX_IMAGE" > "$notes_path"

if [ "${ZAW_PRINT_ONLY:-}" = "1" ]; then
  printf '%s\n' "$notes_path"
  printf '%s\n' "$link_text"
  exit 0
fi

if [ "$open_after" = "1" ]; then
  zaw_open_in_zed -e "$notes_path"
fi

printf 'Exported Skim notes: %s\n' "$notes_path"
printf 'File link: %s\n' "$link_text"
