// Merged into ~/.config/zed/settings.json by `zaw setup-zed`.
// __HOME__ is replaced with your home directory at merge time
// (texlab spawns this executable directly, so it needs an absolute path).
{
  // Read by zaw's PDF opener. Zed itself does not interpret this option.
  "enable_pdf_preview": __ENABLE_PDF_PREVIEW__,
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "auxDirectory": ".build",
            "logDirectory": ".build",
            "pdfDirectory": ".build",
            "onSave": false,
            "forwardSearchAfter": false,
            "executable": "__HOME__/.local/bin/zaw",
            "args": [
              "build",
              "-synctex=1",
              "-interaction=nonstopmode",
              "-file-line-error",
              "-halt-on-error",
              "%f"
            ]
          },
          "forwardSearch": {
            "executable": "__HOME__/.local/bin/zaw",
            "args": ["forward-search", "%f", "%l", "%p"]
          }
        }
      }
    }
  }
}
